---
import MainLayout from './layouts/MainLayout.astro';
---

<MainLayout 
  title="DYNAMISK CONTENT" 
  description="Jeg hjælper dig med at skabe et univers, der fastholder dit publikum fra første sekund."
>
    <div class="timeline">
        <div class="timeline__line"></div>
        
        <section class="hero hero--landingpage">
            <h1 class="h1 h1--landingpage">DYNAMISK CONTENT</h1>
            <h2 class="h2--landingpage">DER SKÆRER IGENNEM STØJEN</h2>
            <div class="hero--landingpage__scroll"><h2 class="h2--scroll">SCROLL</h2></div>
        </section>

        <section class="hook">
            <h2>I EN VERDEN AF UENDELIG SCROLL</h2>
            <p>Er opmærksomhed blevet en vigtig valuta. Jeg skaber <strong>ikke bare indhold</strong>, men <strong>visuelle oplevelser</strong>, der fastholder seeren.</p>
        </section>
    
        <h2 class="h2 h2--stats">ALGORITMEFORSTÅELSE I HØJSÆDET</h2>
        
        <section class="stats-flex">
            <div class="stat-item">
                <h2>100K+</h2>
                <p>Community Reach</p>
            </div>
            <div class="stat-item">
                <h2>50M+</h2>
                <p>TOTALE VISNINGER</p>
            </div>
            <div class="stat-item">
                <h2>113%</h2>
                <p>ENGAGEMENT RATE</p>
            </div>
            <p class="stats-description">
                Jeg omsætter data og tendenser til visuel valuta, der skaber <strong>reel vækst</strong> og fastholder opmærksomheden.
            </p>
        </section>

        <div class="staff-badge">
            <img src="/images/staff_badge.webp" alt="Lucas Liltorp - 24 år - Stud. Multimediedesign" loading="lazy">
        </div>
                
        <h2 class="h2--cases">UDVALGTE CASES</h2>
        
        <div class="cases-list">
            <article class="case-item">
                <div class="case-item__visual">
                    <video controls autoplay muted loop playsinline>
                        <source src="/videos/lsl_optimized.mp4" type="video/mp4">
                    </video>
                </div>
                <div class="case-item__info">
                    <h3>VISUALS</h3>
                    <div class="case-item__tags">[VIDEO] [SHORTFORM]</div>
                    <p>Denne video skal ses som et manifest for den kreative og eksperimenterende retning jeg kan tilbyde.</p>
                </div>
            </article>
        </div>

        <div class="knap__container">
            <a href="/cases" class="knap">SE CASES</a>
        </div>
    </div>
</Layout>