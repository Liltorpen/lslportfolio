---
// src/components/Header.astro
const { pathname } = Astro.url;

const isActive = (path: string) => pathname === path || pathname === path + '/';
---

<header>
    <div class="logo">
        <a href="/"><img src="/images/lsl_logo.svg" alt="LSL Studio Logo"></a>
    </div>
    <nav>
        <ul class="nav">
            <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
            <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
            <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        </ul>
        <button class="nav-burger" aria-label="Menu">
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </nav>
    <ul class="nav--mobile">
        <li class="logo"><a href="/"><img src="/images/lsl_logo.svg" alt="LSL STUDIO LOGO"></a></li>
        <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
        <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
        <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        <li><p class="nav__link--mobile-c">LSL 2025. ALL RIGHTS RESERVED</p></li>
    </ul>
</header>

<script>
    const initBurger = () => {
        const burger = document.querySelector('.nav-burger');
        const navMobile = document.querySelector('.nav--mobile');
        const links = document.querySelectorAll('.nav--mobile .nav__link');

        if (burger && navMobile) {
            const newBurger = burger.cloneNode(true);
            if (burger.parentNode) {
                burger.parentNode.replaceChild(newBurger, burger);
            }
            
            newBurger.addEventListener('click', () => {
                (newBurger as HTMLElement).classList.toggle('active');
                navMobile.classList.toggle('active');
                document.body.style.overflow = navMobile.classList.contains('active') ? 'hidden' : 'auto';
            });

            links.forEach(link => {
                link.addEventListener('click', () => {
                    (newBurger as HTMLElement).classList.remove('active');
                    navMobile.classList.remove('active');
                    document.body.style.overflow = 'auto';
                });
            });
        }
    };

    document.addEventListener('astro:page-load', initBurger);
</script>

<style>    
    header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background-color: rgba(22, 20, 21, 0.85); 
        backdrop-filter: blur(5px); 
        -webkit-backdrop-filter: blur(5px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 40px;
        border-bottom: 1px solid rgba(243, 226, 200, 0.1);
    }

    .logo img { 
        height: 50px; 
        width: auto; 
        display: block; 
        transition: 0.2s ease-out; 
    }
    .logo img:hover { transform: scale(1.05); }

    .nav { display: flex; align-items: center; list-style: none; gap: 30px; }
    
    .nav__link {
        text-decoration: none;
        color: var(--text-color);
        font-family: var(--font-headline);
        text-transform: uppercase;
        font-weight: 500;
        letter-spacing: 1px;
        font-size: 1.4rem;
        position: relative;
        display: inline-block;
        transition: color 0.3s ease;
    }

    .nav__link::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 2px;
        bottom: -2px;
        left: 0;
        background-color: var(--accent-color);
        transform: scaleX(0);
        transform-origin: bottom right;
    }

    .nav__link:hover { 
        color: var(--accent-color); 
    }

    .nav__link.active::after {
        transform: scaleX(1);
        animation: lineIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes lineIn {
        from {
            transform: scaleX(0);
            transform-origin: bottom right;
        }
        to {
            transform: scaleX(1);
            transform-origin: bottom left;
        }
    }

    .nav-burger {
        display: none; 
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 14px;
        background: transparent;
        border: none;
        cursor: pointer;
        z-index: 2000;
        padding: 0;
    }

    .bar {
        width: 100%;
        height: 2px;
        background-color: var(--text-color);
        transition: all 0.3s cubic-bezier(0.68, -0.6, 0.32, 1.6);
        transform-origin: center;
    }

    .nav-burger.active .bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
        background-color: var(--accent-color);
    }
    .nav-burger.active .bar:nth-child(2) {
        transform: translateY(-6px) rotate(-45deg);
        background-color: var(--accent-color);
    }

    /* Mobile Menu */
    .nav--mobile {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: var(--bg-color);
        display: flex;
        flex-direction: column;
        gap: 95px;
        list-style: none;
        padding: 15px 25px;
        margin: 0;
        z-index: 1500;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .nav--mobile.active {
        opacity: 1;
        pointer-events: all;
    }

    .nav--mobile .nav__link {
        font-size: 3rem;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.4s ease, transform 0.4s ease;
    }
    
    .nav--mobile.active .nav__link {
        opacity: 1;
        transform: translateY(0);
    }

    .nav--mobile.active li:nth-child(2) .nav__link { transition-delay: 0.1s; }
    .nav--mobile.active li:nth-child(3) .nav__link { transition-delay: 0.2s; }
    .nav--mobile.active li:nth-child(4) .nav__link { transition-delay: 0.3s; }
    
    .nav--mobile li:last-child { margin-top: auto; padding-bottom: 20px; }
    
    .nav__link--mobile-c {
        font-size: 0.9rem;
        opacity: 0.6;
        letter-spacing: 1px;
        margin: 0;
        font-family: var(--font-headline);
    }

    @media (max-width: 768px) {
        header { padding: 15px 25px; }
        .nav { display: none; }
        .nav-burger { display: flex; }
    }
</style>