---
// src/components/Header.astro
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path || pathname === path + '/';
---

<header>
    <div class="logo">
        <a href="/"><img src="/images/lsl_logo.svg" alt="LSL Studio Logo"></a>
    </div>
    <nav>
        <ul class="nav">
            <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
            <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
            <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        </ul>
        <button class="nav-burger" aria-label="Menu">
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </nav>
    <ul class="nav--mobile">
        <li class="logo"><a href="/"><img src="/images/lsl_logo.svg" alt="LSL STUDIO LOGO"></a></li>
        <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
        <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
        <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        <li><p class="nav__link--mobile-c">LSL 2025. ALL RIGHTS RESERVED</p></li>
    </ul>
</header>

<script>
    const initBurger = () => {
        const burger = document.querySelector('.nav-burger');
        const navMobile = document.querySelector('.nav--mobile');
        if (burger && navMobile) {
            burger.addEventListener('click', () => {
                burger.classList.toggle('active');
                navMobile.classList.toggle('active');
                document.body.style.overflow = navMobile.classList.contains('active') ? 'hidden' : 'auto';
            });
        }
    };
    document.addEventListener('astro:page-load', initBurger);
</script>

<style>    
    header {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 1000;
        background-color: rgba(17, 16, 16, 0.75); 
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 5vw;
        border-bottom: 1px solid rgba(243, 226, 200, 0.05);
    }

    .logo img { height: 40px; }

    .nav { display: flex; list-style: none; gap: 40px; }
    
    .nav__link {
        text-decoration: none;
        color: var(--text-color);
        font-family: var(--font-headline);
        font-size: 1.1rem;
        letter-spacing: 2px;
        opacity: 0.5;
        transition: all 0.3s ease;
        position: relative;
        padding: 5px 0;
    }

    /* Den orange streg-indikator */
    .nav__link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: var(--accent-color);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .nav__link:hover, .nav__link.active { 
        opacity: 1; 
    }

    .nav__link:hover::after, .nav__link.active::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    /* Burger-menu etc (Genbrugt) */
    .nav-burger { display: none; flex-direction: column; justify-content: space-between; width: 25px; height: 12px; background: transparent; border: none; cursor: pointer; z-index: 2000; }
    .bar { width: 100%; height: 1.5px; background-color: var(--text-color); transition: 0.3s ease; }
    .nav-burger.active .bar:nth-child(1) { transform: translateY(5px) rotate(45deg); }
    .nav-burger.active .bar:nth-child(2) { transform: translateY(-5px) rotate(-45deg); }

    .nav--mobile { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background-color: var(--bg-color); display: flex; flex-direction: column; gap: 40px; list-style: none; padding: 100px 40px; z-index: 1500; opacity: 0; pointer-events: none; transition: 0.4s ease; }
    .nav--mobile.active { opacity: 1; pointer-events: all; }
    .nav--mobile .nav__link { font-size: 2.5rem; }

    @media (max-width: 768px) {
        .nav { display: none; }
        .nav-burger { display: flex; }
    }
</style>