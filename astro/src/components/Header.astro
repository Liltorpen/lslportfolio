---
// src/components/Header.astro
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path || pathname === path + '/';
---

<header>
    <div class="logo">
        <a href="/"><img src="/images/lsl_logo.svg" alt="LSL Studio Logo"></a>
    </div>
    <nav>
        <ul class="nav">
            <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
            <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
            <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        </ul>
        <button class="nav-burger" aria-label="Menu">
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </nav>
    <ul class="nav--mobile">
        <li class="logo"><a href="/"><img src="/images/lsl_logo.svg" alt="LSL STUDIO LOGO"></a></li>
        <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
        <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
        <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        <li><p class="nav__link--mobile-c">LSL 2025. ALL RIGHTS RESERVED</p></li>
    </ul>
</header>

<script>
    const initBurger = () => {
        const burger = document.querySelector('.nav-burger');
        const navMobile = document.querySelector('.nav--mobile');
        if (burger && navMobile) {
            burger.addEventListener('click', () => {
                burger.classList.toggle('active');
                navMobile.classList.toggle('active');
                document.body.style.overflow = navMobile.classList.contains('active') ? 'hidden' : 'auto';
            });
        }
    };
    document.addEventListener('astro:page-load', initBurger);
</script>