---
// src/components/Header.astro
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path || pathname === path + '/';
---

<header>
    <div class="logo">
        <a href="/"><img src="/images/lsl_logo.svg" alt="LSL Studio Logo"></a>
    </div>
    <nav>
        <ul class="nav">
            <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
            <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
            <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
        </ul>
        <button class="nav-burger" aria-label="Menu">
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </nav>
    
    <div class="nav--mobile">
        <div class="nav--mobile__inner">
            <div class="nav--mobile__logo">
                <a href="/"><img src="/images/lsl_logo.svg" alt="LSL STUDIO"></a>
            </div>

            <ul class="nav--mobile__list">
                <li><a class:list={["nav__link", { active: isActive("/cases") }]} href="/cases">CASES</a></li>
                <li><a class:list={["nav__link", { active: isActive("/studio") }]} href="/studio">STUDIO</a></li>
                <li><a class:list={["nav__link", { active: isActive("/kontakt") }]} href="/kontakt">KONTAKT</a></li>
            </ul>
            
            <div class="nav--mobile__footer">
                <p class="nav__link--mobile-c">LSL 2026. ALL RIGHTS RESERVED</p>
            </div>
        </div>
    </div>
</header>

<script>
    import { gsap } from 'gsap';

    const initBurger = () => {
        const burger = document.querySelector('.nav-burger');
        const navMobile = document.querySelector('.nav--mobile');
        // Vi animerer kun links og copyright, da logoet skal føles statisk
        const menuElements = document.querySelectorAll('.nav--mobile__list li, .nav--mobile__footer');
        
        if (!burger || !navMobile) return;

        const menuTl = gsap.timeline({ paused: true });

        menuTl.to(navMobile, {
            autoAlpha: 1,
            duration: 0.3,
            ease: "power2.inOut"
        });

        menuTl.from(menuElements, {
            y: 20,
            opacity: 0,
            duration: 0.6,
            stagger: 0.1,
            ease: "power3.out"
        }, "-=0.1");

        burger.addEventListener('click', () => {
            const isActive = burger.classList.toggle('active');
            navMobile.classList.toggle('active');
            
            if (isActive) {
                menuTl.play();
                document.body.style.overflow = 'hidden';
            } else {
                menuTl.reverse();
                document.body.style.overflow = 'auto';
            }
        });
    };

    document.addEventListener('astro:page-load', initBurger);
</script>