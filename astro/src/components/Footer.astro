---
// src/components/Footer.astro
---

<footer>
    <p class="copyright">LSL 2025. ALL RIGHTS RESERVED</p>
    <div class="social-links">
        <a href="#" aria-label="Instagram"><i class="ri-instagram-line"></i></a>
        <a href="#" aria-label="LinkedIn"><i class="ri-linkedin-fill"></i></a>
        <a href="#" aria-label="Facebook"><i class="ri-facebook-circle-fill"></i></a>
        <a href="#" aria-label="TikTok"><i class="ri-tiktok-fill"></i></a>
    </div>
</footer>

<style>
    footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-top: 1px solid rgba(243, 226, 200, 0.1);
        padding: 40px 25px;
        background-color: var(--bg-color);
        margin-top: auto; /* Sikrer at den ligger i bunden hvis indholdet er kort */
    }

    .copyright {
        font-family: var(--font-headline);
        font-size: clamp(0.8rem, 2vw, 1.1rem);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0;
    }

    .social-links {
        display: flex;
        gap: 30px;
        margin-top: 20px;
    }

    .social-links a {
        text-decoration: none;
        color: var(--text-color);
        font-size: 2rem;
        transition: 0.3s ease;
    }

    .social-links a:hover {
        color: var(--accent-color);
        transform: translateY(-3px);
    }
    
    @media (max-width: 768px) {
        .copyright { font-size: 0.8rem; }
    }
</style>