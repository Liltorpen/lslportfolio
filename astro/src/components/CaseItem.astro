---
const { title, tags, description, image, video, reversed } = Astro.props;
---

<article class:list={["case-item", { "case-item--reversed": reversed }]} class="reveal-up">
    <div class="case-item__visual-wrapper">
        <div class="case-item__inner">
            {video ? (
                <video muted loop playsinline class="smart-video premium-media">
                    <source src={video} type="video/mp4" />
                </video>
            ) : (
                <img src={image} alt={title} loading="lazy" class="premium-media" />
            )}
            <div class="case-overlay"></div>
        </div>
    </div>
    
    <div class="case-item__info">
        <div class="case-item__tags">{tags}</div>
        <h2 class="case-title">{title}</h2>
        <p set:html={description} />
    </div>
</article>

<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target as HTMLVideoElement;
                entry.isIntersecting ? video.play().catch(()=>{}) : video.pause();
            });
        }, { threshold: 0.2 });
        document.querySelectorAll('.smart-video').forEach(v => observer.observe(v));
    });
</script>

<style>
    .case-item {
        display: flex;       
        align-items: center;
        gap: 6vw; 
        margin-bottom: 200px; /* Massiv afstand for pacing */
    }

    .case-item__visual-wrapper {
        flex: 1.4; 
        position: relative;
        border-radius: 4px;
        background-color: #050505;
        padding: 1px; /* Skaber plads til den indre glaskant */
        box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.9), 
                    0 0 0 1px rgba(255, 255, 255, 0.05) inset; /* Glas-kant */
        transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .case-item__inner {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 3px;
    }

    .case-item:hover .case-item__visual-wrapper {
        transform: translateY(-15px) scale(1.02);
        box-shadow: 0 50px 80px -20px rgba(243, 82, 38, 0.15), 
                    0 0 0 1px rgba(243, 82, 38, 0.3) inset; /* Orange glød på kanten */
    }

    .premium-media {
        width: 100%;
        height: auto; 
        max-height: 75vh; 
        object-fit: cover; 
        display: block;
        transform: scale(1.05); /* Starter zoomet ind */
        filter: grayscale(80%) contrast(1.1) brightness(0.8); /* Cinematic, dark, afdæmpet */
        transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1), filter 0.8s ease;
    }

    .case-item:hover .premium-media {
        transform: scale(1); /* Zoomer ud ved hover */
        filter: grayscale(0%) contrast(1) brightness(1); /* Fuld farve */
    }

    .case-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, transparent 40%, rgba(17, 16, 16, 0.8) 120%);
        pointer-events: none;
        transition: opacity 0.5s ease;
    }

    .case-item:hover .case-overlay { opacity: 0; }

    .case-item__info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .case-title {
        font-size: clamp(35px, 4vw, 55px);
        margin: 10px 0 20px;
        letter-spacing: 2px;
        color: var(--text-color);
        transition: color 0.4s ease;
    }

    .case-item:hover .case-title { color: var(--accent-color); }

    .case-item__tags {
        color: var(--text-color);
        opacity: 0.5;
        letter-spacing: 3px;
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
    }

    .case-item--reversed { flex-direction: row-reverse; }

    @media (max-width: 900px) {
        .case-item, .case-item--reversed { flex-direction: column; gap: 40px; margin-bottom: 120px; }
        .case-item__visual-wrapper { width: 100%; }
        .premium-media { filter: grayscale(0%) contrast(1) brightness(1); transform: scale(1); } /* Slå effekter fra på mobil for performance */
    }
</style>