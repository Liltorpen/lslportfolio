---
// src/components/CaseItem.astro
const { title, tags, description, image, video, reversed, delay } = Astro.props;
---

<article 
    class:list={["case-item", { "case-item--reversed": reversed }]} 
    data-aos="fade-up"
    data-aos-delay={delay || 0} 
>
    <div class="case-item__visual">
        {video ? (
            <video muted loop playsinline class="smart-video">
                <source src={video} type="video/mp4" />
                Din browser understøtter ikke video.
            </video>
        ) : (
            <img src={image} alt={title} loading="lazy" />
        )}
    </div>
    
    <div class="case-item__info">
        <h2 class="case-title">{title}</h2>
        <div class="case-item__tags">{tags}</div>
        <p set:html={description} />
        <slot />
    </div>
</article>

<script>
    document.addEventListener('astro:page-load', () => {
        const videos = document.querySelectorAll('.smart-video');

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target as HTMLVideoElement;
                if (entry.isIntersecting) {
                    video.play().catch(() => {
                        console.log('Autoplay forhindret af browseren');
                    });
                } else {
                    video.pause();
                }
            });
        }, { threshold: 0.25 });

        videos.forEach(video => observer.observe(video));
    });
</script>

<style>
    .smart-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>