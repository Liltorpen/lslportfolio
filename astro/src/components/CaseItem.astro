---
const { title, tags, description, image, video, reversed } = Astro.props;
---

<article class:list={["case-item", { "case-item--reversed": reversed }]} class="reveal-up">
    <div class="case-item__visual-wrapper">
        <div class="case-item__inner">
            {video ? (
                <video controls muted loop playsinline class="smart-video premium-media">
                    <source src={video} type="video/mp4" />
                </video>
            ) : (
                <img src={image} alt={title} loading="lazy" class="premium-media" />
            )}
            <div class="case-wrap"></div>
            <div class="case-overlay"></div>
        </div>
    </div>
    
    <div class="case-item__info">
        <div class="case-item__tags">{tags}</div>
        <h2 class="case-title">{title}</h2>
        <div class="case-description" set:html={description} />
    </div>
</article>

<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target as HTMLVideoElement;
                if (entry.isIntersecting) {
                    video.play().catch(()=>{});
                } else {
                    video.pause();
                }
            });
        }, { threshold: 0.2 });
        
        document.querySelectorAll('.smart-video').forEach(v => observer.observe(v));
    });
</script>