---
const skills = [
    "AFTER EFFECTS", "PREMIERE PRO", "PHOTOSHOP", "ILLUSTRATOR", 
    "LIGHTROOM", "INDESIGN", "FIGMA", "HTML5 / CSS3", 
    "SHORTFORM STRATEGI", "BRANDING"
];
---

<section class="skills-section reveal-up">
    <div class="skills-header">
        <span class="label">TOOLKIT</span>
        <h2 class="section-title">TEKNISKE KOMPETENCER</h2>
    </div>
    <div class="skills-grid">
        {skills.map(skill => (
            <div class="skill-box">
                <span class="skill-name">{skill}</span>
            </div>
        ))}
    </div>
</section>

<style>
    .skills-section {
        max-width: 1200px;
        margin: 0 auto 150px;
        padding: 0 20px;
    }
    .skills-header { text-align: center; margin-bottom: 60px; }
    .label {
        color: var(--accent-color);
        font-family: var(--font-headline);
        letter-spacing: 5px;
        font-size: 0.9rem;
        display: block;
        margin-bottom: 10px;
    }
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        border-top: 1px solid rgba(243, 226, 200, 0.1);
        border-left: 1px solid rgba(243, 226, 200, 0.1);
    }
    .skill-box {
        padding: 50px 30px;
        border-right: 1px solid rgba(243, 226, 200, 0.1);
        border-bottom: 1px solid rgba(243, 226, 200, 0.1);
        display: flex;
        justify-content: center;
        align-items: center;
        transition: all 0.4s ease;
        background: transparent;
    }
    .skill-box:hover { background: rgba(243, 82, 38, 0.03); }
    .skill-name {
        font-family: var(--font-headline);
        font-size: 1.1rem;
        letter-spacing: 2px;
        opacity: 0.5;
        transition: all 0.3s ease;
    }
    .skill-box:hover .skill-name { opacity: 1; color: var(--accent-color); transform: scale(1.05); }

    @media (max-width: 768px) {
        .skills-grid { grid-template-columns: 1fr 1fr; }
        .skill-box { padding: 30px 15px; }
    }
</style>