---
import { skills } from '../data/skills.js';
---

<div class="skills-list">
    {skills.map((skill, index) => (
        <div class="skill-row" data-skill={skill.name.toLowerCase()}>
            <div class="skill-row__content">
                <span class="skill-index">0{index + 1}</span>
                <div class="skill-info">
                    <h3 class="skill-name">{skill.name}</h3>
                    <span class="skill-type">{skill.type}</span>
                </div>
                <p class="skill-desc">{skill.desc}</p>
            </div>
            <div class="skill-row__line"></div>
        </div>
    ))}
</div>

<script>
    import { gsap } from 'gsap';

    const initSkillHover = () => {
        const rows = document.querySelectorAll('.skill-row');
        if (window.matchMedia("(hover: none)").matches) return;

        rows.forEach(row => {
            row.addEventListener('mouseenter', () => {
                gsap.to(row, { 
                    paddingLeft: "40px", 
                    duration: 0.4, 
                    ease: "power2.out" 
                });
            });

            row.addEventListener('mouseleave', () => {
                gsap.to(row, { 
                    paddingLeft: "0px", 
                    duration: 0.4, 
                    ease: "power2.out" 
                });
            });
        });
    };

    document.addEventListener('astro:page-load', initSkillHover);
</script>