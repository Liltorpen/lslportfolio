---
import MainLayout from '../layouts/MainLayout.astro';
import CaseItem from '../components/CaseItem.astro';
import Button from '../components/Button.astro';
import { casesData } from '../data/cases.js';

const selectedCases = [casesData[0], casesData[1], casesData[3]];
---

<MainLayout title="PORTFOLIO">
    <section class="hero hero--landingpage">
        <div class="hero__content">
            <h1 class="h1--landingpage hero-anim">LSL STUDIO</h1>
            <h2 class="h2--landingpage hero-anim">PORTFOLIO</h2>
        </div>
        <div class="hero__scroll hero-anim-late">
    <div class="scroll-ticker">
        <span>EXPLORE</span>
        <span>VISION</span>
        <span>CREATIVE</span>
        <span>MOTION</span>
        <span>PORTFOLIO</span>
        <span>PROJECTS</span>
        <span class="final-word">SCROLL</span>
    </div>
</div>
    </section>

    <section class="hook reveal-up">
       <div class="soft-glow-bg">
            <h2>I EN VERDEN AF UENDELIG SCROLL</h2>
            <p>Er opmærksomhed blevet en vigtig valuta. Jeg skaber <strong>ikke bare indhold</strong>, men <strong>visuelle oplevelser</strong>, der fastholder seeren. <br><br>Uanset om det er motion graphics, visuel identitet, plakater eller brochure: bygger jeg broen mellem <strong>kunstnerisk kant</strong> og <strong>kommerciel værdi</strong>.</p>
        </div> 
    </section>

    <section class="stats-section reveal-up">
        <div class="soft-glow-bg">
            <h2 class="section-title">ALGORITMEFORSTÅELSE I HØJSÆDET</h2>
            
            <div class="stats-flex">
                <div class="stat-item">
                    <h2 class="stat-number" data-target="100">0</h2><span>K+</span>
                    <p>Community Reach</p>
                </div>
                <div class="stat-item">
                    <h2 class="stat-number" data-target="50">0</h2><span>M+</span>
                    <p>TOTALE VISNINGER</p>
                </div>
                <div class="stat-item">
                    <h2 class="stat-number" data-target="113">0</h2><span>%</span>
                    <p>ENGAGEMENT RATE</p>
                </div>
            </div>
            <p class="stats-description">Gennem arbejde med mine egne platforme har jeg opnået en unik forståelse af algoritmerne på TikTok og Instagram. Jeg omsætter data og tendenser til visuel valuta, der skaber <strong>reel vækst</strong> og fastholder opmærksomheden.</p>
        </div>
    </section>

    <div class="staff-badge reveal-mask">
        <img src="/images/staff_badge.webp" alt="Lucas Liltorp - 24 år - Stud. Multimediedesign" loading="lazy">
    </div> 

    <section class="cases-section">
        <h2 class="section-title section-title--cases reveal-up">UDVALGTE CASES</h2>
        <div class="cases-list">
            {selectedCases.map((item, index) => (
                <CaseItem {...item} reversed={index % 2 !== 0} />
            ))}
        </div>
    </section>

    <Button href="/cases" text="SE ALLE CASES" />
</MainLayout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';
    
    gsap.registerPlugin(ScrollTrigger, SplitText);

    document.addEventListener('astro:page-load', () => {
        const heroAnims = document.querySelectorAll('.hero-anim');
        if (heroAnims.length > 0) {
            gsap.fromTo(heroAnims, { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 1.5, stagger: 0.2, ease: "power4.out" });
        }

        const ticker = document.querySelector('.scroll-ticker');
        const heroAnimLate = document.querySelector('.hero-anim-late');

        if (ticker && heroAnimLate) {
            gsap.fromTo(heroAnimLate, { opacity: 0 }, { 
                opacity: 0.5, 
                duration: 1.5, 
                delay: 1,
                onComplete: () => {
                    gsap.to(ticker, {
                        y: "-85.7%", // (6/7 * 100)
                        duration: 2.5,
                        ease: "expo.inOut",
                        onComplete: () => {
                            const finalWord = new SplitText(".final-word", { type: "chars" });
                            gsap.from(finalWord.chars, {
                                opacity: 0,
                                scale: 1.5,
                                stagger: 0.1,
                                duration: 0.5,
                                ease: "back.out(2)"
                            });
                        }
                    });
                }
            });
        }

        document.querySelectorAll('.stat-number').forEach(stat => {
            const target = parseInt(stat.getAttribute('data-target') || '0');
            gsap.to(stat, {
                innerHTML: target,
                duration: 3.5,
                snap: { innerHTML: 1 },
                ease: "power2.out",
                scrollTrigger: { trigger: stat, start: "top 85%" }
            });
        });
    });
</script>