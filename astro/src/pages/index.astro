---
import MainLayout from '../layouts/MainLayout.astro';
import CaseItem from '../components/CaseItem.astro';

const selectedCases = [
    { title: "VISUALS", tags: "[VIDEO] [SHORTFORM]", video: "/videos/lsl_optimized.mp4", description: `Denne video skal ses som et manifest for den kreative og eksperimenterende retning jeg kan tilbyde indenfor videoproduktion. Med særligt henblik på musik.<br><br><i>Medie-aktiverne er blevet transformeret gennem omfattende redigering i Premiere Pro og After Effects for at skabe et nyt kunstnerisk udtryk.</i>` },
    { title: "MERCH", tags: "[MERCH] [GRAFIK] [MOCKUP]", image: "/images/merch.webp", description: `Designs som adskiller sig fra mængden - designs som <strong>skærer igennem</strong> støjen. Jeg hjælper med at designe merch, hvad end det er til labels, brands eller kunstnere.` },
    { title: "KONCERTPLAKAT", tags: "[TRYKTE MEDIER]", image: "/images/koncertplakat.webp", description: `Lamin optræder i Bella Arena d. 21 februar. 2026. Jeg udarbejdede derfor et eksempel på hvordan en koncertplakat, kunne se ud. Lamins grafik er generelt inspireret fra den amerikanske scene - det tog jeg derfor også udgangspunkt i.` }
];
---

<MainLayout title="PORTFOLIO">
    <div class="timeline">
        <div class="timeline__track">
            <div class="timeline__line"></div>
        </div>

        <section class="hero hero--landingpage">
            <div class="hero__content">
                <h1 class="h1--landingpage hero-anim">LSL STUDIO</h1>
                <h2 class="h2--landingpage hero-anim">PORTFOLIO</h2>
            </div>
            <div class="hero__scroll hero-anim-late">SCROLL</div>
        </section>

        <section class="hook reveal-up">
            <h2>I EN VERDEN AF UENDELIG SCROLL</h2>
            <p>Er opmærksomhed blevet en vigtig valuta. Jeg skaber <strong>ikke bare indhold</strong>, men <strong>visuelle oplevelser</strong>, der fastholder seeren. Uanset om det er motion graphics, visuel identitet, plakater eller brochure: bygger jeg broen mellem <strong>kunstnerisk kant</strong> og <strong>kommerciel værdi</strong>.</p>
        </section>
    
        <section class="stats-section reveal-up">
            <h2 class="section-title">ALGORITMEFORSTÅELSE I HØJSÆDET</h2>
            <div class="stats-flex">
                <div class="stat-item">
                    <h2 class="stat-number" data-target="100">0</h2><span>K+</span>
                    <p>Community Reach</p>
                </div>
                <div class="stat-item">
                    <h2 class="stat-number" data-target="50">0</h2><span>M+</span>
                    <p>TOTALE VISNINGER</p>
                </div>
                <div class="stat-item">
                    <h2 class="stat-number" data-target="113">0</h2><span>%</span>
                    <p>ENGAGEMENT RATE</p>
                </div>
            </div>
            <p class="stats-description">Gennem arbejde med mine egne platforme har jeg opnået en unik forståelse af algoritmerne på TikTok og Instagram. Jeg omsætter data og tendenser til visuel valuta, der skaber <strong>reel vækst</strong> og fastholder opmærksomheden.</p>
        </section>

        <div class="staff-badge reveal-mask">
            <img src="/images/staff_badge.webp" alt="Lucas Liltorp - 24 år - Stud. Multimediedesign" loading="lazy">
        </div> 

        <section class="cases-section">
            <h2 class="section-title reveal-up">UDVALGTE CASES</h2>
            <div class="cases-list">
                {selectedCases.map((item, index) => (
                    <CaseItem {...item} reversed={index % 2 !== 0} />
                ))}
            </div>
        </section>

        <div class="knap__container reveal-up">
            <a href="/cases" class="knap">SE ALLE CASES</a>
        </div>
    </div>
</MainLayout>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('astro:page-load', () => {
        // Tjek om .hero-anim findes på siden, før vi animerer
        const heroAnims = document.querySelectorAll('.hero-anim');
        if (heroAnims.length > 0) {
            gsap.fromTo(heroAnims, { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 1.5, stagger: 0.2, ease: "power4.out" });
        }

        // Tjek om .hero-anim-late findes på siden
        const heroAnimLate = document.querySelectorAll('.hero-anim-late');
        if (heroAnimLate.length > 0) {
            gsap.fromTo(heroAnimLate, { opacity: 0 }, { opacity: 1, duration: 2, delay: 1 });
        }

        // Tæller animation (forEach ignorerer automatisk, hvis listen er tom)
        document.querySelectorAll('.stat-number').forEach(stat => {
            const target = parseInt(stat.getAttribute('data-target') || '0');
            gsap.to(stat, {
                innerHTML: target,
                duration: 2.5,
                snap: { innerHTML: 1 },
                ease: "power2.out",
                scrollTrigger: { trigger: stat, start: "top 85%" }
            });
        });
    });
</script>
