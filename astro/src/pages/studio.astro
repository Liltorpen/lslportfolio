---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="STUDIO" description="Lær mere om Lucas Liltorp og LSL Studio.">
    <div class="timeline">
        <div class="timeline__line"></div>
        <section class="hero">
            <h1>STUDIO</h1>
        </section>
        <div class="intro-container intro-container--studio">
            <img class="studio-img" src="/images/hero.webp" alt="Behind the scenes hos LSL Studio">
        </div>
    </div>  
    <section class="bts">
        <h2>KOM MED BEHIND THE SCENES</h2>
        <p>Bag LSL Studio står jeg, Lucas. Jeg er hardcore After Effects-bruger og ekspert i shortform content.</p>
    </section>
    
    <section class="skills-container">
        <h3 class="h3--skills">MIN VÆRKTØJSKASSE</h3>
        <div class="skill-cloud">
            <span class="skill-tag">AFTER EFFECTS</span>
            <span class="skill-tag">PREMIERE PRO</span>
            <span class="skill-tag">PHOTOSHOP</span>
            <span class="skill-tag">FIGMA</span>
            <span class="skill-tag">HTML5 / CSS3</span>
        </div>
    </section>
</MainLayout>