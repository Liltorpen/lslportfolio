---
import MainLayout from '../layouts/MainLayout.astro';
import SkillCloud from '../components/SkillCloud.astro';
---

<MainLayout title="STUDIO">
    <div class="timeline">
        <div class="timeline__track">
            <div class="timeline__line"></div>
        </div>
       
        <section class="hero hero--small">
            <div class="hero__content">
                <h1 class="reveal-up">STUDIO</h1>
            </div>
        </section>

        <div class="intro-container reveal-mask">
            <img class="studio-img" src="/images/hero.webp" alt="Lucas Liltorp">
            <div class="img-overlay"></div>
        </div>

        <section class="bts reveal-up">
            <div class="bts__header">
                <h2>BEHIND THE SCENES</h2>
            </div>
            <div class="bts__content">
                <div class="bts__col">
                    <p>Bag LSL Studio står jeg, <strong>Lucas</strong>. En 24-årig multimediedesigner passioneret omkring alt, hvad der rører sig inden for visuel kommunikation. For mig er design ikke bare statiske billeder... <br><br>Det er <strong>levende fortællinger</strong>, der skal mærkes.</p>
                </div>
                <div class="bts__col">
                    <p>Min styrke ligger i krydsfeltet mellem designvision og teknisk håndværk. Jeg er hardcore <strong>After Effects-bruger</strong> og ekspert i shortform content, men tænker altid i hele løsninger.<br><br>Jeg hjælper brands med at skabe et visuelt univers, der fastholder publikum fra første sekund.</p>
                </div>
            </div>
        </section>

        <section class="process reveal-up">
            <div class="bts__header">
                <span class="label">WORKFLOW</span>
                <h2 class="section-title">MIN PROCES</h2>
            </div>
            <div class="process__grid">
                <div class="process__item">
                    <span class="step">01.</span>
                    <h3>STRATEGI</h3>
                    <p>Jeg dykker ned i dit brand, dine mål og din målgruppe for at lægge fundamentet for det visuelle udtryk.</p>
                </div>
                <div class="process__item">
                    <span class="step">02.</span>
                    <h3>EKSEKVERING</h3>
                    <p>Her vækkes ideerne til live gennem high-end motion graphics, video og grafisk præcision.</p>
                </div>
                <div class="process__item">
                    <span class="step">03.</span>
                    <h3>OPTIMERING</h3>
                    <p>Jeg finjusterer indholdet til de specifikke platforme, så det performer maksimalt i algoritmen.</p>
                </div>
            </div>
        </section>
       
        <SkillCloud />
          
        <div class="knap__container reveal-up">
            <a href="/kontakt" class="knap">START ET PROJEKT</a>
        </div>
    </div>
</MainLayout>