---
import MainLayout from '../layouts/MainLayout.astro';
import SkillCloud from '../components/SkillCloud.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<MainLayout title="STUDIO">
    <PageHero title="STUDIO"/>

    <div class="intro-container reveal-up">
        <img class="studio-img" src="/images/hero.webp" alt="Lucas Liltorp">
    </div>

    <section class="bts reveal-up">
        <div class="soft-glow-bg"><div class="bts__header">
            <h2 class="section-title">BEHIND THE SCENES</h2>
        </div>
        <div class="bts__content">
            <div class="bts__col">
                <p>Bag LSL Studio står jeg, <strong>Lucas</strong>. En 24-årig multimediedesigner passioneret omkring alt, hvad der rører sig inden for visuel kommunikation. For mig er design ikke bare statiske billeder... <br><br>Det er <strong>levende fortællinger</strong>, der skal mærkes.</p>
            </div>
            <div class="bts__col">
                <p>Min styrke ligger i krydsfeltet mellem designvision og teknisk håndværk. Jeg er hardcore <strong>After Effects-bruger</strong> og ekspert i shortform content, men tænker altid i hele løsninger.<br><br>Jeg hjælper dig med at skabe et visuelt univers, der fastholder publikum fra første sekund.</p>
            </div>
        </div></div>
    </section>

    <section class="skills-section reveal-up">
    <div class="soft-glow-bg"><div class="skills-header">
        <span class="label">TOOLKIT</span>
        <h2 class="section-title">VÆRKTØJSKASSE</h2></div>
    </div>
    <SkillCloud />
    </section>
    <Button href="/kontakt" text="START ET PROJEKT" />
</MainLayout>