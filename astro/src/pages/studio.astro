---
import MainLayout from '../layouts/MainLayout.astro';
import SkillCloud from '../components/SkillCloud.astro';
---

<MainLayout title="STUDIO">
    <div class="timeline">
        <div class="timeline__track">
            <div class="timeline__line"></div>
        </div>
       
        <section class="hero hero--small">
            <h1 class="reveal-up">STUDIO</h1>
        </section>

        <div class="intro-container reveal-mask">
            <img class="studio-img" src="/images/hero.webp" alt="Lucas Liltorp">
            <div class="img-overlay"></div>
        </div>

        <section class="bts reveal-up">
            <div class="bts__header">
                <h2>BEHIND THE SCENES</h2>
            </div>
            <div class="bts__content">
                <div class="bts__col">
                    <p>Bag LSL Studio står jeg, Lucas. En 24-årig multimediedesigner passioneret omkring alt, hvad der rører sig inden for <strong>visuel kommunikation</strong>. For mig er design ikke bare statiske billeder...</p>
                    <p>Det er <strong>levende fortællinger</strong>.</p>
                </div>
                <div class="bts__col">
                    <p>Min styrke ligger i krydsfeltet mellem designvision og teknisk håndværk. Jeg er <strong>hardcore After Effects-bruger</strong> og ekspert i shortform content, men jeg tænker altid i hele løsninger - fra grafik og branding til kode.</p>
                    <p>Jeg hjælper dig med at skabe et univers, der fastholder dit publikum fra første sekund.</p>
                </div>
            </div>
        </section>

        <section class="process reveal-up">
            <h2 class="section-title">MIN ARBEJDSPROCES</h2>
            <div class="process__grid">
                <div class="process__item">
                    <span class="step">01</span>
                    <h3>STRATEGI</h3>
                    <p>Vi definerer målet og finder den visuelle vinkel, der skærer igennem støjen.</p>
                </div>
                <div class="process__item">
                    <span class="step">02</span>
                    <h3>EKSEKVERING</h3>
                    <p>Konceptet bringes til live gennem After Effects, Premiere Pro og knivskarp grafik.</p>
                </div>
                <div class="process__item">
                    <span class="step">03</span>
                    <h3>LEVERING</h3>
                    <p>Det færdige indhold leveres i formater optimeret til dine platforme.</p>
                </div>
            </div>
        </section>
        
        <SkillCloud />
          
        <div class="knap__container reveal-up">
            <a href="/kontakt" class="knap">START ET PROJEKT</a>
        </div>
    </div>
</MainLayout>

<style>
    .hero--small { 
        min-height: 50vh; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        text-align: center;
    }
    
    .intro-container { 
        width: 100vw; 
        height: 65vh; 
        position: relative; 
        left: 50%; 
        right: 50%; 
        margin-left: -50vw; 
        margin-right: -50vw; 
        margin-bottom: 150px; 
        overflow: hidden; 
    }
    .studio-img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(30%); }
    .img-overlay { position: absolute; inset: 0; background: linear-gradient(to top, var(--bg-color), transparent 50%); }

    .bts { max-width: 1000px; margin: 0 auto 150px; }
    .bts__header { margin-bottom: 60px; border-bottom: 1px solid rgba(243, 226, 200, 0.1); padding-bottom: 20px; text-align: center; }
    .bts__header h2 { font-size: 3.5rem; color: var(--accent-color); }
    
    .bts__content { display: flex; gap: 60px; }
    .bts__col { flex: 1; }
    .bts__col p { margin-bottom: 20px; line-height: 1.8; }

    /* Proces Styling */
    .process { max-width: 1200px; margin: 0 auto 150px; text-align: center; }
    .process__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 60px; }
    .process__item { text-align: left; padding: 30px; background: rgba(255,255,255,0.02); border-left: 2px solid var(--accent-color); }
    .step { font-family: var(--font-headline); color: var(--accent-color); font-size: 1.2rem; opacity: 0.5; }
    .process__item h3 { margin: 10px 0; letter-spacing: 2px; }

    @media (max-width: 768px) {
        .bts__content, .process__grid { flex-direction: column; grid-template-columns: 1fr; gap: 30px; }
        .intro-container { height: 45vh; }
        .bts__header h2 { font-size: 2.5rem; }
    }
</style>