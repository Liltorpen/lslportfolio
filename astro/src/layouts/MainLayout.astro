---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import 'aos/dist/aos.css';

const { title, description } = Astro.props;

// src/components/Header.astro
const { pathname } = Astro.url;

const isActive = (path: string) => {
    const cleanPathname = pathname.replace(/\/$/, "");
    const cleanPath = path.replace(/\/$/, "");
    return cleanPathname === cleanPath;
};
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title ? `${title} | LSL STUDIO` : 'LSL STUDIO'}</title>
    <meta name="description" content={description || "LSL Studio - Visuelle oplevelser der skærer igennem støjen."}>
    
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    
    <ClientRouter />
</head>
<body>
    <Header />

    <main>
        <slot />
    </main>

    <Footer />

<script>
    import AOS from 'aos';

    const initAOS = () => {
        const animatedElements = document.querySelectorAll('.aos-animate');
        animatedElements.forEach(el => el.classList.remove('aos-animate'));

        setTimeout(() => {
            AOS.init({
                duration: 800,
                once: true,
                offset: 20,
                delay: 0,
                easing: 'ease-out-cubic'
            });
            
            AOS.refresh();
        }, 200); 
    };

    initAOS();
    document.addEventListener('astro:page-load', initAOS);
    
    document.addEventListener('astro:after-swap', AOS.refresh);
</script>
</body>
</html>