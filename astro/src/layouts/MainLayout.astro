---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

const siteTitle = title ? `${title} | LSL STUDIO` : 'LSL STUDIO | Visuelle oplevelser der skærer igennem støjen';
const siteDescription = description || "LSL Studio - Specialist i shortform content, motion graphics og visuel identitet.";
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />

<script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);
    
    let lenis: any;
    let resizeObserver: ResizeObserver | null = null;

    const initPremiumExperience = () => {
        // 1. Lenis Smooth Scroll Setup
        lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => { lenis.raf(time * 1000); });
        gsap.ticker.lagSmoothing(0);

        // 2. --- TIMELINE LOGIK (PRÆCISIONS-FIX) ---
        const timelineLine = document.querySelector('.timeline__line') as HTMLElement;
        const timelineTrack = document.querySelector('.timeline__track') as HTMLElement;

        if (timelineLine && timelineTrack) {
            // Nulstil alt før start
            gsap.set(timelineLine, { height: 0, opacity: 0 });

            gsap.to(timelineLine, {
                height: "100%",
                opacity: 1,
                ease: "none",
                scrollTrigger: {
                    trigger: timelineTrack, // Trigger på selve banen for 100% præcision
                    start: "top 65%",       // Begynder først at vokse når den er sikkert under header blur
                    end: "bottom 75%",      // Er færdig når bunden af banen (knappen) rammer det nedre område
                    scrub: 0.5,             // Gør bevægelsen flydende og premium
                    invalidateOnRefresh: true, 
                }
            });
        }

        // 3. --- REVEAL ANIMATIONER (STABILITETS-FIX) ---
        // Reveal Up (Tekst og sektioner)
        const reveals = document.querySelectorAll('.reveal-up');
        reveals.forEach((el) => {
            gsap.set(el, { y: 50, opacity: 0 }); // Tvungen start-state for View Transitions

            gsap.to(el, {
                y: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el,
                    start: "top 92%", // Trigger når elementet næsten er synligt
                    toggleActions: "play none none none"
                }
            });
        });

        // FIX: Reveal Mask (Billeder og hero sektioner, f.eks. Studio Hero)
        const masks = document.querySelectorAll('.reveal-mask');
        masks.forEach((mask) => {
            gsap.to(mask, {
                clipPath: 'inset(0% 0 0 0)',
                duration: 1.5,
                ease: "power4.inOut",
                scrollTrigger: {
                    trigger: mask,
                    start: "top 90%",
                }
            });
        });

        // 4. ResizeObserver sikrer at GSAP kender sidens rigtige højde
        const mainElement = document.querySelector('main');
        if (mainElement) {
            resizeObserver = new ResizeObserver(() => {
                ScrollTrigger.refresh();
            });
            resizeObserver.observe(mainElement);
        }

        ScrollTrigger.refresh();
    };

    // Første kørsel
    initPremiumExperience();

    // Astro Page Load handler til View Transitions
    document.addEventListener('astro:page-load', () => {
        // Ryd op i gamle instanser
        ScrollTrigger.killAll(); 
        if (lenis) lenis.destroy();
        if (resizeObserver) resizeObserver.disconnect();
        
        requestAnimationFrame(() => {
            initPremiumExperience();
            // Vi venter lidt længere på at View Transitions er helt færdige før refresh
            setTimeout(() => {
                ScrollTrigger.refresh();
            }, 500); 
        });
    });

    // Handle vindue resize
    window.addEventListener('resize', () => ScrollTrigger.refresh());
</script>
</body>
</html>