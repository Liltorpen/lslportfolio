---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const { title, description } = Astro.props;
---
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | LSL STUDIO</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
    <header>
        <div class="logo"><a href="/"><img src="/images/lsl_logo.svg" alt="LSL LOGO"></a></div>
        <nav>
            <ul class="nav">
                <li><a class="nav__link" href="/cases">CASES</a></li>
                <li><a class="nav__link" href="/studio">STUDIO</a></li>
                <li><a class="nav__link" href="/kontakt">KONTAKT</a></li>
            </ul>
            <button class="nav-burger" aria-label="Menu"><span class="bar"></span><span class="bar"></span></button>
        </nav>
        <ul class="nav--mobile">
            <li><a class="nav__link" href="/cases">CASES</a></li>
            <li><a class="nav__link" href="/studio">STUDIO</a></li>
            <li><a class="nav__link" href="/kontakt">KONTAKT</a></li>
        </ul>
    </header>

    <main>
        <slot />
    </main>

    <footer>
        <p class="copyright">LSL 2025. ALL RIGHTS RESERVED</p>
        <div class="social-links">
            <a href="#"><i class="ri-instagram-line"></i></a>
            <a href="#"><i class="ri-linkedin-fill"></i></a>
            <a href="#"><i class="ri-tiktok-fill"></i></a>
        </div>
    </footer>

    <script>
        import AOS from 'aos';
        import 'aos/dist/aos.css';

        // Burgermenu logik
        const setupBurger = () => {
            const burger = document.querySelector('.nav-burger');
            const navMobile = document.querySelector('.nav--mobile');
            if (burger && navMobile) {
                burger.addEventListener('click', () => {
                    burger.classList.toggle('active');
                    navMobile.classList.toggle('active');
                });
            }
        };

        // AOS logik
        const initScripts = () => {
            setupBurger();
            AOS.init({ duration: 800, once: true });
        };

        document.addEventListener('astro:page-load', initScripts);
    </script>
</body>
</html>