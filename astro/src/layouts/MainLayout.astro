---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import 'aos/dist/aos.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// SEO Metadata
const siteTitle = title ? `${title} | LSL STUDIO` : 'LSL STUDIO | Visuelle oplevelser der skærer igennem støjen';
const siteDescription = description || "LSL Studio - Specialist i shortform content, motion graphics og visuel identitet. Skaber visuelle fortællinger der fastholder dit publikum.";
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <meta name="author" content="Lucas Liltorp">
    <link rel="canonical" href={Astro.url}>
    
    <meta property="og:type" content="website">
    <meta property="og:url" content={Astro.url}>
    <meta property="og:title" content={siteTitle}>
    <meta property="og:description" content={siteDescription}>
    <meta property="og:image" content="/images/hero.webp">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Lucas Liltorp",
        "jobTitle": "Multimediedesigner",
        "url": "https://lucasliltorp.dk",
        "knowsAbout": ["Shortform Content", "After Effects", "Motion Graphics", "Branding"]
      }
    </script>
    
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    
    <ClientRouter />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />

<script>
    import AOS from 'aos';
    import Lenis from 'lenis';

    let lenis: any;

    const initScripts = () => {
        // 1. Studio Lenis (Smooth Scroll)
        lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // 2. AOS Initialisering
        AOS.init({
            duration: 800,
            once: true,
            offset: 20,
            easing: 'ease-out-cubic'
        });

        // Synkroniser AOS med Lenis scroll
        lenis.on('scroll', AOS.refresh);
    };

    // Kør ved load og efter Astro transitions
    initScripts();
    document.addEventListener('astro:page-load', () => {
        if (lenis) lenis.destroy();
        initScripts();
    });
</script>
</body>
</html>