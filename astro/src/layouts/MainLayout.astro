---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title ? `${title} | LSL STUDIO` : 'LSL STUDIO'}</title>
    <meta name="description" content={description || "Jeg tror på, at i en verden fuld af støj, er det kun de levende fortællinger, der skaber ægte resonans."}>

    <meta property="og:type" content="website">
    <meta property="og:title" content="LSL STUDIO">
    <meta property="og:description" content="Jeg tror på, at i en verden fuld af støj, er det kun de levende fortællinger, der skaber ægte resonans.">
    
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    
    <ClientRouter />
</head>
<body>
    <header>
        <div class="logo">
            <a href="/"><img src="/images/lsl_logo.svg" alt="LSL Studio Logo"></a>
        </div>
        <nav>
            <ul class="nav">
                <li><a class="nav__link" href="/cases">CASES</a></li>
                <li><a class="nav__link" href="/studio">STUDIO</a></li>
                <li><a class="nav__link" href="/kontakt">KONTAKT</a></li>
            </ul>
            <button class="nav-burger" aria-label="Menu">
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </nav>
        <ul class="nav--mobile">
            <li class="logo"><a href="/"><img src="/images/lsl_logo.svg" alt="LSL STUDIO LOGO"></a></li>
            <li><a class="nav__link" href="/cases">CASES</a></li>
            <li><a class="nav__link" href="/studio">STUDIO</a></li>
            <li><a class="nav__link" href="/kontakt">KONTAKT</a></li>
            <li><p class="nav__link--mobile-c">LSL 2025. ALL RIGHTS RESERVED</p></li>
        </ul>
    </header>

    <main>
        <slot />
    </main>

    <footer>
        <p class="copyright">LSL 2025. ALL RIGHTS RESERVED</p>
        <div class="social-links">
            <a href="#"><i class="ri-instagram-line"></i></a>
            <a href="#"><i class="ri-linkedin-fill"></i></a>
            <a href="#"><i class="ri-facebook-circle-fill"></i></a>
            <a href="#"><i class="ri-tiktok-fill"></i></a>
        </div>
    </footer>

    <script>
        import AOS from 'aos';
        import 'aos/dist/aos.css';

        // Funktion til at starte alt op (Burger + AOS)
        const init = () => {
            // AOS Init
            AOS.init({
                duration: 800,
                once: true,
                offset: 50
            });

            // Burger Menu Logic (fra din burgermenu.js)
            const burger = document.querySelector('.nav-burger');
            const navMobile = document.querySelector('.nav--mobile');
            const links = document.querySelectorAll('.nav--mobile .nav__link');

            if (burger && navMobile) {
                // Fjern gamle event listeners (for at undgå dubletter ved navigation)
                const newBurger = burger.cloneNode(true);
                if (burger.parentNode) {
                    burger.parentNode.replaceChild(newBurger, burger);
                }
                
                newBurger.addEventListener('click', () => {
                    newBurger.classList.toggle('active');
                    navMobile.classList.toggle('active');
                    document.body.style.overflow = navMobile.classList.contains('active') ? 'hidden' : 'auto';
                });

                links.forEach(link => {
                    link.addEventListener('click', () => {
                        newBurger.classList.remove('active');
                        navMobile.classList.remove('active');
                        document.body.style.overflow = 'auto';
                    });
                });
            }
        };

        // Kør ved første load og ved hver side-skift (ClientRouter)
        document.addEventListener('astro:page-load', init);
    </script>
</body>
</html>