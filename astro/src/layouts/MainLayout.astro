---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

const siteTitle = title ? `${title} | LSL STUDIO` : 'LSL STUDIO | Visuelle oplevelser der skærer igennem støjen';
const siteDescription = description || "LSL Studio - Specialist i shortform content, motion graphics og visuel identitet.";
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />

<script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);
    let lenis: any;

    const initPremiumExperience = () => {
        // 1. Lenis Smooth Scroll Setup
        lenis = new Lenis({
            duration: 1.2, // Lidt hurtigere for en mere responsiv følelse
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        // 2. --- OPTIMERET TIMELINE LOGIK ---
        const timelineLine = document.querySelector('.timeline__line') as HTMLElement;
        const timelineTrack = document.querySelector('.timeline__track') as HTMLElement;
        const knapContainer = document.querySelector('.knap__container');

        if (timelineLine && timelineTrack && knapContainer) {
            // Funktion til at beregne den præcise pixel-destination
            const getStopPoint = () => {
                const knapRect = knapContainer.getBoundingClientRect();
                const trackRect = timelineTrack.getBoundingClientRect();
                const scrollY = window.scrollY;
                // Returnerer afstanden fra toppen af banen til midten af knappen
                return (knapRect.top + scrollY) - (trackRect.top + scrollY) + (knapRect.height / 2);
            };

            gsap.to(timelineLine, {
                height: () => getStopPoint(), // Brug funktion for dynamisk opdatering
                ease: "none",
                scrollTrigger: {
                    trigger: "body",
                    start: "top top",
                    endTrigger: knapContainer,
                    end: "center center",
                    scrub: 0.1, // Langt mere snappy end 0.5
                    invalidateOnRefresh: true, // Genberegner alt ved resize/load
                }
            });
        }

        // 3. Reveal Animationer (Subtilt fade up)
        const revealUps = document.querySelectorAll('.reveal-up');
        revealUps.forEach((el) => {
            gsap.fromTo(el, 
                { y: 30, opacity: 0 },
                {
                    y: 0,
                    opacity: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 90%",
                        toggleActions: "play none none none"
                    }
                }
            );
        });

        // 4. Reveal Masks (Editorial image reveal)
        const revealMasks = document.querySelectorAll('.reveal-mask');
        revealMasks.forEach((mask) => {
            gsap.to(mask, {
                clipPath: 'inset(0% 0 0 0)',
                duration: 1.4,
                ease: "power4.inOut",
                scrollTrigger: {
                    trigger: mask,
                    start: "top 85%",
                }
            });
        });
    };

    // Kør init load
    initPremiumExperience();

    // Re-init efter Astro sidskift
    document.addEventListener('astro:page-load', () => {
        ScrollTrigger.killAll(); 
        if (lenis) lenis.destroy();
        initPremiumExperience();
    });
</script>
</body>
</html>