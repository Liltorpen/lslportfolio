---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

const siteTitle = title ? `${title} | LSL STUDIO` : 'LSL STUDIO | Visuelle oplevelser der skærer igennem støjen';
const siteDescription = description || "LSL Studio - Specialist i shortform content, motion graphics og visuel identitet.";
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />

<script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);
    let lenis: any;

    const initPremiumExperience = () => {
        lenis = new Lenis({
            duration: 1.5,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);

        // --- FORBEDRET TIMELINE LOGIK ---
        const timelineLine = document.querySelector('.timeline__line') as HTMLElement;
        const timelineContainer = document.querySelector('.timeline');
        const knap = document.querySelector('.knap'); // Finder den første knap (Call to action)

        if (timelineLine && timelineContainer && knap) {
            const updateTimeline = () => {
                const timelineRect = timelineContainer.getBoundingClientRect();
                const knapRect = knap.getBoundingClientRect();
                
                // Beregn afstanden fra toppen af tidslinjen til midten af knappen
                const scrollY = window.scrollY;
                const stopPoint = (knapRect.top + scrollY) - (timelineRect.top + scrollY) + (knapRect.height / 2);

                gsap.to(timelineLine, {
                    height: stopPoint,
                    ease: "none",
                    scrollTrigger: {
                        trigger: "body",
                        start: "top top",
                        endTrigger: knap,
                        end: "center center",
                        scrub: 0.4
                    }
                });
            };

            updateTimeline();
            window.addEventListener('resize', updateTimeline);
        }

        // Reveal animationer
        document.querySelectorAll('.reveal-up').forEach((el) => {
            gsap.to(el, {
                y: 0, opacity: 1, duration: 1.2, ease: "power3.out",
                scrollTrigger: { trigger: el, start: "top 85%" }
            });
        });

        document.querySelectorAll('.reveal-mask').forEach((mask) => {
            gsap.to(mask, {
                clipPath: 'inset(0% 0 0 0)', duration: 1.5, ease: "power4.inOut",
                scrollTrigger: { trigger: mask, start: "top 80%" }
            });
        });
    };

    initPremiumExperience();
    document.addEventListener('astro:page-load', () => {
        ScrollTrigger.killAll(); 
        if (lenis) lenis.destroy();
        initPremiumExperience();
    });
</script>
</body>
</html>