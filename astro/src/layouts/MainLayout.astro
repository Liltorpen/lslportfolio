---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

const siteTitle = title ? `${title} | LSL STUDIO` : 'LSL STUDIO | Visuelle oplevelser der skærer igennem støjen';
const siteDescription = description || "LSL Studio - Specialist i shortform content, motion graphics og visuel identitet.";
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />

<script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);
    
    let lenis: any;
    let resizeObserver: ResizeObserver | null = null;

    const initPremiumExperience = () => {
        // 1. Lenis Smooth Scroll Setup
        lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        // 2. --- TIMELINE LOGIK ---
        const timelineLine = document.querySelector('.timeline__line') as HTMLElement;
        const timelineTrack = document.querySelector('.timeline__track') as HTMLElement;
        const knapContainer = document.querySelector('.knap__container');

        if (timelineLine && timelineTrack && knapContainer) {
            // Beregn stop-punktet dynamisk
            const getStopPoint = () => {
                const knapRect = knapContainer.getBoundingClientRect();
                const trackRect = timelineTrack.getBoundingClientRect();
                const scrollY = window.scrollY;
                // Finder midten af knappen relativt til banens start
                return (knapRect.top + scrollY) - (trackRect.top + scrollY) + (knapRect.height / 2);
            };

            gsap.to(timelineLine, {
                height: () => getStopPoint(), // Brug funktion så den altid henter frisk data
                ease: "none",
                scrollTrigger: {
                    trigger: "body",
                    start: "top top",
                    endTrigger: knapContainer,
                    end: "center center",
                    scrub: 0.1,
                    invalidateOnRefresh: true, // Genberegner ved refresh
                }
            });
        }

        // 3. Reveal Animationer
        document.querySelectorAll('.reveal-up').forEach((el) => {
            gsap.fromTo(el, 
                { y: 30, opacity: 0 },
                {
                    y: 0,
                    opacity: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 90%",
                        toggleActions: "play none none none"
                    }
                }
            );
        });

        // 4. --- DET AFGØRENDE FIX: ResizeObserver ---
        // Denne holder øje med om dine videoer/billeder ændrer sidens højde efter load
        const mainElement = document.querySelector('main');
        if (mainElement) {
            resizeObserver = new ResizeObserver(() => {
                // Hver gang main-elementet ændrer højde, beder vi GSAP om at måle efter igen
                ScrollTrigger.refresh();
            });
            resizeObserver.observe(mainElement);
        }

        // Tving en måling med det samme
        ScrollTrigger.refresh();
    };

    // Initial kørsel
    initPremiumExperience();

    // Astro Page Load handler (View Transitions fix)
    document.addEventListener('astro:page-load', () => {
        // Ryd op i gamle instanser for at undgå memory leaks og konflikter
        ScrollTrigger.killAll(); 
        if (lenis) lenis.destroy();
        if (resizeObserver) resizeObserver.disconnect();
        
        // Vent på næste frame så browseren har tegnet den nye side
        requestAnimationFrame(() => {
            initPremiumExperience();
            
            // Ekstra sikkerheds-refresh efter 200ms
            setTimeout(() => {
                ScrollTrigger.refresh();
            }, 200);
        });
    });

    // Handle vindue resize
    window.addEventListener('resize', () => ScrollTrigger.refresh());
</script>
</body>
</html>