---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title ? `${title} | LSL STUDIO` : 'LSL STUDIO'}</title>
    <meta name="description" content={description || "LSL Studio - Visuelle oplevelser der skærer igennem støjen."}>
    
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    
    <ClientRouter />
</head>
<body>
    <Header />

    <main>
        <slot />
    </main>

    <Footer />

    <script>
        import AOS from 'aos';
        import 'aos/dist/aos.css';

        // Initialiser AOS animationer
        const initAOS = () => {
            AOS.init({
                duration: 1000,
                once: true,
                offset: 50
            });
        };

        // Kør ved start og ved hver side-transition
        initAOS();
        document.addEventListener('astro:page-load', initAOS);
    </script>
</body>
</html>