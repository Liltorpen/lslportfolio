---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { 
    title?: string; 
    description?: string; 
    shortTimeline?: boolean;
}
const { title, description, shortTimeline = false } = Astro.props;

const siteTitle = title ? `${title} | LSL STUDIO` : 'LSL STUDIO | Multimediedesign Portfolio';
const siteDescription = description || "LSL Studio - Multimediedesign Portfolio";
---

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <link rel="icon" type="image/svg+xml" href="/images/lsl_logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
    <div class="site-wrapper">
        <Header />
        <main>
            <div class="timeline">
                <div class:list={["timeline__track", { "timeline__track--short": shortTimeline }]}>
                    <div class="timeline__line"></div>
                </div>
                
                <slot />
                
            </div>
        </main>
        <Footer />
    </div>

<script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);
    
    ScrollTrigger.config({ ignoreMobileResize: true });
    
    let lenis: any;

    const initPremiumExperience = () => {
        lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => { lenis.raf(time * 1000); });
        gsap.ticker.lagSmoothing(0);

        const timelineLine = document.querySelector('.timeline__line') as HTMLElement;
        const timelineTrack = document.querySelector('.timeline__track') as HTMLElement;

        if (timelineLine && timelineTrack) {
            gsap.set(timelineLine, { scaleY: 0, opacity: 0.5 });
            
            gsap.to(timelineLine, {
                scaleY: 1,
                ease: "none",
                scrollTrigger: {
                    trigger: timelineTrack,
                    start: "top 70%", 
                    end: "bottom 80%", 
                    scrub: 1,  
                    invalidateOnRefresh: true, 
                }
            });
        }

        // Standard reveal animationer
        const reveals = document.querySelectorAll('.reveal-up');
        reveals.forEach((el) => {
            gsap.set(el, { y: 40, opacity: 0 }); 
            gsap.to(el, {
                y: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el,
                    start: "top 92%", 
                    toggleActions: "play none none none"
                }
            });
        });

        const masks = document.querySelectorAll('.reveal-mask');
        masks.forEach((mask) => {
            gsap.to(mask, {
                clipPath: 'inset(0% 0 0 0)',
                duration: 1.5,
                ease: "power4.inOut",
                scrollTrigger: {
                    trigger: mask,
                    start: "top 90%",
                }
            });
        });

        // Sikkerheds-refresh når alt er fuldt indlæst
        window.addEventListener('load', () => {
            ScrollTrigger.refresh();
        });
        
        setTimeout(() => {
            ScrollTrigger.refresh();
        }, 1000);

        ScrollTrigger.refresh();
    };

    document.addEventListener('astro:page-load', () => {
        ScrollTrigger.killAll(); 
        if (lenis) lenis.destroy();
        
        requestAnimationFrame(() => {
            initPremiumExperience();
            setTimeout(() => {
                ScrollTrigger.refresh();
            }, 300); 
        });
    });
</script>
</body>
</html>